---
layout: layouts/base.njk
permalink: /podcast/
title: "Geospatially Africa Podcast - Iniobong Benson"
description: "Geospatially Africa is a podcast by Iniobong Benson exploring geospatial science, mapping, and spatial data across the African continent."
---
{% from "partials/episode-row.njk" import row %}

<div class="podcast-page">
  <header class="page-head">
    <div class="wrap">
      <h1 class="page-head__h">Podc<em>ast</em></h1>
      <p class="page-head__desc">Geospatially Africa explores geospatial science, mapping, and spatial data across the African continent - conversations with researchers, practitioners, and innovators.</p>
      <div class="pod-cta">
        {% if site.podcast.spotify %}<a class="lbtn" href="{{ site.podcast.spotify }}" target="_blank" rel="noopener">Spotify</a>{% endif %}
        {% if site.podcast.apple %}<a class="lbtn" href="{{ site.podcast.apple }}" target="_blank" rel="noopener">Apple Podcasts</a>{% endif %}
        {% if site.podcast.rss %}<a class="lbtn" href="{{ site.podcast.rss }}" target="_blank" rel="noopener">RSS</a>{% endif %}
      </div>
    </div>
  </header>

  <section class="page-sec">
    <div class="wrap">
      <div class="ep-full-list">
        {% for e in episodes %}{{ row(e, true) }}{% endfor %}
      </div>
    </div>
  </section>
</div>
